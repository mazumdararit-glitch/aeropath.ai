# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.log

# Local data caches. These are reproducible from the public APIs and are
# large, so they stay out of history.
cache/
scratch/osm_cache/
*.pkl

# Secrets
#
# Every .env* file is ignored, including .env.example. The usual convention is to
# track a template via "!.env.example", but that is how a real key ended up in
# git history once (it was pasted into the template rather than .env). Ignoring
# the whole family makes that mistake impossible; the variables are documented in
# the README instead.
.env
.env.*
!.env.example

# Agent/tooling state
.commandcode/

# OS noise
Thumbs.db
desktop.ini
.DS_Store
