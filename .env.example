# AEROPATH Configuration

# Grid Data Provider: "open_meteo" (default, live, keyless) or "xkdr" (station measurements)
GRID_PROVIDER=open_meteo

# Optional: XKDR India Air Quality API key (free from https://airquality.xkdr.org/signup)
# XKDR_API_KEY=

# Optional: Live Ground Station Feeds (Sprint 1 - A2)
# WAQI_TOKEN=your_waqi_token_here
# OPENAQ_API_KEY=your_openaq_api_key_here

# Routing Service (OSRM demo server or self-hosted)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_S=15.0

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aeropath

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_S=900
